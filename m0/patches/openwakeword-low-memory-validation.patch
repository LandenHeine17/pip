 # Separate function to convert onnx models to tflite format
+
+class _FpWindows(torch.utils.data.Dataset):
+    """Pip M0 patch: overlapping (window x 96) feature windows with label 0, built on demand."""
+    def __init__(self, feats, window):
+        self.feats, self.window = feats, window
+    def __len__(self):
+        return self.feats.shape[0] - self.window
+    def __getitem__(self, i):
+        return torch.from_numpy(np.array(self.feats[i:i + self.window], dtype=np.float32)), torch.tensor(0.0)
+
