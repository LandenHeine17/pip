 # Separate function to convert onnx models to tflite format
+
+class _FpWindows(torch.utils.data.Dataset):
+    """Pip M0 patch: overlapping (window x 96) feature windows with label 0, one whole batch per item
+    (built with a strided view, so memory stays small and each batch is a single fast copy)."""
+    def __init__(self, feats, window, batch=4096):
+        self.feats, self.window, self.batch = feats, window, batch
+        self.n = feats.shape[0] - window
+    def __len__(self):
+        return (self.n + self.batch - 1) // self.batch
+    def __getitem__(self, b):
+        lo, hi = b * self.batch, min(self.n, (b + 1) * self.batch)
+        chunk = np.asarray(self.feats[lo:hi + self.window - 1], dtype=np.float32)
+        x = np.lib.stride_tricks.sliding_window_view(chunk, self.window, axis=0).transpose(0, 2, 1)[: hi - lo]
+        return torch.from_numpy(np.ascontiguousarray(x)), torch.zeros(hi - lo)
+
+
