[Unit]
Description=Pip: pip-ears (listening and speaking)
After=pip-core.service
Wants=pip-core.service

[Service]
WorkingDirectory=%h/pip-app/current
ExecStart=%h/pip-app/current/.venv/bin/pip-ears
Restart=on-failure
RestartSec=3
MemoryMax=600M
MemorySwapMax=0
Nice=0

[Install]
WantedBy=default.target
