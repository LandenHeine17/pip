[Unit]
Description=Pip: pip-builder (self-changes: hands them to Claude Hub, follows them, undoes them)
After=pip-core.service
Wants=pip-core.service

[Service]
ExecStart=%h/pip-app/current/.venv/bin/pip-builder
WorkingDirectory=%h/pip-app/current
Restart=on-failure
RestartSec=3
# Small: Claude works on the changes in Claude Hub; an undo's install runs as its own capped systemd job.
MemoryMax=300M
MemorySwapMax=0
Nice=5

[Install]
WantedBy=default.target
