[Unit]
Description=Pip: pip-core (the conductor: messages, decision trace, watchdog, timers, memory, voices)


[Service]
WorkingDirectory=%h/pip-app/current
ExecStart=%h/pip-app/current/.venv/bin/pip-core
Restart=on-failure
RestartSec=3
MemoryMax=700M
MemorySwapMax=0
Nice=0

[Install]
WantedBy=default.target
