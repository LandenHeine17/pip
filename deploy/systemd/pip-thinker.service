[Unit]
Description=Pip: pip-thinker (asks Claude for Pip's answers)
After=pip-core.service
Wants=pip-core.service

[Service]
WorkingDirectory=%h/pip-app/current
ExecStart=%h/pip-app/current/.venv/bin/pip-thinker
Restart=on-failure
RestartSec=3
MemoryMax=2G
MemorySwapMax=0
Nice=0

[Install]
WantedBy=default.target
