# Shows Pip's face on the monitor plugged into the Pi, from boot, with no desktop (step 7, D-110).
# A system service (not a user one like pip-core), because it has to take over the screen's console.
# Installed by deploy/install-tv.sh, which fills in the @...@ values. Replaces Ziggletron's ziggletron-tv.
[Unit]
Description=Pip's face on the monitor
After=systemd-user-sessions.service network.target systemd-logind.service getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=@USER@
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty1
UtmpMode=user
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
# Harmless lines from the screen program (cage) when you switch to another slot (Ctrl+Alt+F2/F3) and back, or
# when it starts while another slot has the screen: it isn't allowed to touch the screen then, and the face carries on
# when you come back. X11 support isn't installed and isn't needed. Kept out of the journal, so the owner's process
# monitor doesn't list them as errors (2026-11-19). Anything else it says is still logged.
LogFilterPatterns=~Failed to disable CRTC
LogFilterPatterns=~Atomic commit failed: Permission denied
LogFilterPatterns=~[Xx][Ww]ayland
LogFilterPatterns=~Backend 'seatd' failed to open seat
Environment=PIP_TV_URL=http://127.0.0.1:@PORT@/tv
# cage can only start while tty1 is the console on the screen. If someone is using another one (Ctrl+Alt+F2)
# when it (re)starts, wait for them to come back to tty1 (Ctrl+Alt+F1) instead of failing every 10 s.
ExecStartPre=/bin/sh -c 'until [ "$(cat /sys/class/tty/tty0/active)" = tty1 ]; do sleep 2; done'
TimeoutStartSec=infinity
ExecStart=/usr/bin/cage -d -s -- @REPO@/deploy/tv/tv-kiosk.sh
Restart=always
RestartSec=5
# A fresh browser once a day, so months of running can't slowly use up the memory: pip-tv-restart.timer does it at
# 4 am, when nobody's watching (owner, 2026-11-17). This is only the backstop, if that timer ever doesn't run.
RuntimeMaxSec=2d

[Install]
WantedBy=multi-user.target
